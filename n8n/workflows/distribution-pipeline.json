{
  "name": "Distribution Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "/webhook/content-published"
      },
      "id": "content-webhook",
      "name": "Content Published",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {"value1": "={{$json.type}}", "operation": "equal", "value2": "beat"}
          ]
        }
      },
      "id": "content-type-check",
      "name": "Check Content Type",
      "type": "n8n-nodes-base.if",
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{$env.MCP_SERVER_URL}}/api/distribution/app",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "contentId", "value": "={{$json.id}}"},
            {"name": "platform", "value": "app"}
          ]
        }
      },
      "id": "distribute-to-app",
      "name": "Distribute to App",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 200]
    },
    {
      "parameters": {
        "url": "={{$env.MCP_SERVER_URL}}/api/distribution/extension",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "contentId", "value": "={{$json.id}}"},
            {"name": "platform", "value": "extension"}
          ]
        }
      },
      "id": "distribute-to-extension",
      "name": "Distribute to Extension",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 400]
    }
  ],
  "connections": {
    "Content Published": {
      "main": [["Check Content Type"]]
    },
    "Check Content Type": {
      "main": [
        ["Distribute to App"],
        ["Distribute to Extension"]
      ]
    }
  },
  "active": true
}