    "Notify Admin Access": {
      "main": [
        [
          {
            "node": "Sync Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Track Profile Analytics": {
      "main": [
        [
          {
            "node": "Sync Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "User Signup Webhook": {
      "main": [
        [
          {
            "node": "Check Signup Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Signup Context": {
      "main": [
        [
          {
            "node": "Create New Profile",
            "type": "main",
