          }
        ]
      ]
    },
    "Create New Profile": {
      "main": [
        [
          {
            "node": "Add Signup Wallet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add Signup Wallet": {
      "main": [
        [
          {
