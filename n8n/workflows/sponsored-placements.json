    {
      "parameters": {
        "jsCode": "// Metadata Complete Placement Processing\nconst placementData = $input.first().json;\n\nreturn {\n  placement_type: 'metadata_complete',\n  revenue: 5.00,\n  service: 'Premium NFT Features',\n  user_id: placementData.user_id,\n  conversion_value: 'very_high',\n  attribution: {\n    source: 'metadata_form',\n    step: 1,\n    timestamp: new Date().toISOString()\n  },\n  campaign_data: {\n    title: 'Premium NFT Features',\n    description: 'Gasless minting, advanced analytics, priority support',\n    cta: 'Upgrade Now',\n    target_audience: 'engaged_users'\n  }\n};"
