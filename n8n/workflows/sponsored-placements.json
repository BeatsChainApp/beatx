      "parameters": {
        "jsCode": "// Success Placement Processing\nconst placementData = $input.first().json;\n\nreturn {\n  placement_type: 'success',\n  revenue: 1.50,\n  service: 'Success Sharing',\n  user_id: placementData.user_id,\n  conversion_value: 'medium',\n  attribution: {\n    source: 'success_page',\n    step: 5,\n    timestamp: new Date().toISOString()\n  },\n  campaign_data: {\n    title: 'Congratulations!',\n    description: 'Share your success and connect with other artists',\n    cta: 'Share Now',\n    target_audience: 'successful_minters'\n  }\n};"
