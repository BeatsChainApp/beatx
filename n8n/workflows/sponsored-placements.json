{
  "name": "Sponsored Placements",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "/webhook/user-interaction"
      },
      "id": "interaction-webhook",
      "name": "User Interaction",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {"value1": "={{$json.context}}", "operation": "equal", "value2": "extension"}
          ]
        }
      },
      "id": "context-filter",
      "name": "Filter by Context",
      "type": "n8n-nodes-base.if",
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{$env.MCP_SERVER_URL}}/api/sponsors/get-placement",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "userId", "value": "={{$json.userId}}"},
            {"name": "context", "value": "={{$json.context}}"},
            {"name": "action", "value": "={{$json.action}}"},
            {"name": "consentGiven", "value": "={{$json.consentGiven}}"}
          ]
        }
      },
      "id": "get-sponsor-content",
      "name": "Get Sponsor Content",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 300]
    }
  ],
  "connections": {
    "User Interaction": {
      "main": [["Filter by Context"]]
    },
    "Filter by Context": {
      "main": [["Get Sponsor Content"]]
    }
  },
  "active": true
}