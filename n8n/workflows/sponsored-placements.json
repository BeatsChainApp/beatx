    {
      "parameters": {
        "jsCode": "// Pre-Mint Placement Processing\nconst placementData = $input.first().json;\n\nreturn {\n  placement_type: 'pre_mint',\n  revenue: 4.00,\n  service: 'Analytics & Promotion',\n  user_id: placementData.user_id,\n  conversion_value: 'high',\n  attribution: {\n    source: 'pre_minting',\n    step: 4,\n    timestamp: new Date().toISOString()\n  },\n  campaign_data: {\n    title: 'Analytics & Promotion',\n    description: 'Track performance and boost your music',\n    cta: 'Promote',\n    target_audience: 'ready_to_mint'\n  }\n};"
