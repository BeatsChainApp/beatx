      "parameters": {
        "jsCode": "// Upload Start Placement Processing\nconst placementData = $input.first().json;\n\nreturn {\n  placement_type: 'upload_start',\n  revenue: 2.50,\n  service: 'Professional Upload Service',\n  user_id: placementData.user_id,\n  conversion_value: 'high',\n  attribution: {\n    source: 'upload_form',\n    step: 0,\n    timestamp: new Date().toISOString()\n  },\n  campaign_data: {\n    title: 'Professional Upload Service',\n    description: 'ISRC codes, professional metadata, distribution-ready files',\n    cta: 'Learn More',\n    target_audience: 'new_uploaders'\n  }\n};"
      },
