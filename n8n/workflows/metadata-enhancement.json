{
  "name": "Metadata Enhancement",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "/webhook/audio-uploaded"
      },
      "id": "audio-webhook",
      "name": "Audio Uploaded",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{$env.MCP_SERVER_URL}}/api/ai/analyze-audio",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "audioUrl", "value": "={{$json.audioUrl}}"},
            {"name": "filename", "value": "={{$json.filename}}"}
          ]
        }
      },
      "id": "analyze-audio",
      "name": "AI Audio Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{$env.MCP_SERVER_URL}}/api/metadata/enhance",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "audioId", "value": "={{$json.audioId}}"},
            {"name": "analysis", "value": "={{$json.analysis}}"},
            {"name": "genre", "value": "={{$json.detectedGenre}}"},
            {"name": "bpm", "value": "={{$json.bpm}}"}
          ]
        }
      },
      "id": "enhance-metadata",
      "name": "Enhance Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 300]
    }
  ],
  "connections": {
    "Audio Uploaded": {
      "main": [["AI Audio Analysis"]]
    },
    "AI Audio Analysis": {
      "main": [["Enhance Metadata"]]
    }
  },
  "active": true
}